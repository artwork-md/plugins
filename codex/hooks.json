{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^mcp__.+__artwork_[a-z_]+$",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "sh \"$PLUGIN_ROOT/waker/hook.sh\" PostToolUse",
            "statusMessage": "Artwork: listen for comments"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__.+__artwork_relay$",
        "hooks": [
          { "type": "command", "timeout": 5, "command": "sh \"$PLUGIN_ROOT/waker/hook.sh\" refuse" }
        ]
      },
      {
        "matcher": "^mcp__.+__artwork_wait$",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "sh \"$PLUGIN_ROOT/waker/hook.sh\" PreToolUse"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "sh \"$PLUGIN_ROOT/waker/hook.sh\" SessionStart"
          }
        ]
      }
    ]
  }
}
